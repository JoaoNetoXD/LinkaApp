# Frontend / Supabase client
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Backend / Supabase privileged operations
# Required in production for admin routes and the health check.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Pagamentos na plataforma (Mercado Pago)
# Desligados na fase atual: o aluno compra direto com a empresa.
# Com PAYMENTS_ENABLED=false as rotas de pagamento respondem 410 e as chaves abaixo são opcionais.
PAYMENTS_ENABLED=false
MP_ACCESS_TOKEN=APP_USR-seu-access-token-de-producao
MP_CLIENT_ID=seu-app-id-mercado-pago
MP_CLIENT_SECRET=seu-client-secret-mercado-pago

# Public URLs
# In Netlify production: FRONTEND_URL=https://linka-app.netlify.app until the iCEV subdomain
# redirect is live, then https://<subdominio>. Extra addresses the API must accept:
# ALLOWED_ORIGINS=https://<subdominio>,https://linka-app.netlify.app
# Canonical site URL for Supabase Auth e-mail redirects and link previews (Open Graph).
# Leave empty until the final address has HTTPS: the browser then uses the current origin
# and the build uses Netlify's URL variable. Never point it at an old address.
VITE_APP_URL=
# WEBHOOK_URL and MP_REDIRECT_URI are derived automatically from FRONTEND_URL.
FRONTEND_URL=http://localhost:5173
WEBHOOK_URL=http://localhost:3000/api/webhook
MP_REDIRECT_URI=http://localhost:3000/api/mercadopago/oauth/callback

# Frontend API URL
# Keep empty in Netlify production so the app calls /api on the same domain.
VITE_API_URL=/api

# Optional
PORT=3000
